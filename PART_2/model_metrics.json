{
  "project": "OCTCV Capstone Three - Physics-Informed Augmentation",
  "dataset": {
    "total_volumes": 1110,
    "augmented_volumes": 6660,
    "train_augmented": 5328,
    "validation": 111,
    "evaluation": 111,
    "class_distribution": {
      "glaucoma": 847,
      "normal": 263,
      "ratio": "76% / 24%"
    }
  },
  "augmentation_parameters": {
    "gamma_bright": 1.67,
    "gamma_dark": 0.6,
    "rayleigh_noise_scale": 0.67,
    "lpf_radius": 30,
    "fan_pivot_distance": 121
  },
  "training_config": {
    "optimizer": "NAdam",
    "base_learning_rate": 1e-4,
    "loss": "binary_crossentropy",
    "batch_size": 4,
    "max_epochs": 80,
    "early_stopping_patience": 5,
    "early_stopping_monitor": "val_auc",
    "restore_best_weights": true,
    "class_balancing": "none (unbalanced as-is)"
  },
  "results": {
    "part1_baselines": {
      "sequential": {
        "auc": 0.88,
        "epochs_trained": 11,
        "training_data": "original_888"
      },
      "resnet_like": {
        "auc": 0.94,
        "epochs_trained": 15,
        "training_data": "original_888"
      },
      "attention": {
        "auc": 0.93,
        "epochs_trained": 18,
        "training_data": "original_888"
      }
    },
    "part2_augmented": {
      "sequential": {
        "auc_range": [0.82, 0.88],
        "training_data": "augmented_5328",
        "note": "Consistently equal or below Part 1 baseline"
      },
      "resnet_like": {
        "auc_range": [0.87, 0.92],
        "training_data": "augmented_5328",
        "note": "Below Part 1 baseline of 0.94"
      },
      "attention": {
        "auc_range": [0.88, 0.93],
        "training_data": "augmented_5328",
        "note": "Approximately equal to Part 1"
      }
    },
    "hyperparameter_tuning": {
      "learning_rates_tested": [5e-5, 1e-4, 3e-4, 5e-4],
      "best_lr": "varies by run (~1e-4 to 3e-4)",
      "note": "Tuning did not overcome augmentation ceiling"
    }
  },
  "final_model": {
    "name": "ResNet-Like (Part 1)",
    "architecture": "Conv3D stem + 3 residual blocks + GAP + Dense(sigmoid)",
    "training_data": "Original 888 volumes (no augmentation)",
    "best_auc": 0.94,
    "rationale": "Augmentation did not improve any architecture; Part 1 ResNet-Like remains best"
  },
  "key_findings": [
    "6x augmentation did NOT improve AUC for any architecture",
    "Class balancing (downsampling) is harmful — confirmed from Part 1",
    "Performance ceiling (~0.94) is dataset diversity limited, not volume limited",
    "ResNet-Like architecture is consistently the best performer",
    "Original paper's finding of augmentation hurting is reproduced"
  ]
}
